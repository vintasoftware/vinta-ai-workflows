{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/vintasoftware/vinta-ai-workflows/schemas/workflow.v1.schema.json",
  "title": "vinta-flow workflow",
  "description": "An executable plan: the phase DAG, the pipelines phases run through, the capacity pools they contend for, and the gates they must pass. Lives at `ai-plans/<feature-kebab>.workflow.json` in a target project, emitted by `plan-feature` alongside the human-readable plan and executed by `vinta-flow`. GENERATED from packages/vinta-flow/src/types.ts — edit there, not here. See schemas/README.md for versioning rules.",
  "type": "object",
  "properties": {
    "$schema": {
      "description": "Optional URL of this schema, for editor validation. Ignored at runtime.",
      "type": "string"
    },
    "schema_version": {
      "type": "number",
      "const": 1,
      "description": "Schema major version. Bumped only on breaking changes."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Stable identifier for this workflow. Used in branch names."
    },
    "plan_ref": {
      "description": "The human-readable plan this was emitted alongside.",
      "type": "string"
    },
    "plan_context_refs": {
      "default": [],
      "description": "Sections of the plan that bound every phase rather than any one of them — its Goals + Non-goals and its Guiding Decisions. Each is a file-and-anchor reference in the same form as `prompt_ref` (`ai-plans/PLAN.md#1-goals`), resolved by the same resolver and handed to the implementer and the reviewer verbatim, marked as plan-level. Empty — the default — means the prompts carry the phase brief alone.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "base_branch": {
      "type": "string",
      "minLength": 1,
      "description": "What dependency-free nodes branch from."
    },
    "project": {
      "type": "object",
      "properties": {
        "migrate_cmd": {
          "type": "string",
          "minLength": 1,
          "description": "The project’s own migrate command. Run once per template database — never per lane, which is what makes the Nth lane cost a copy rather than a provision."
        },
        "databases": {
          "default": {},
          "description": "Roles a lane forks. An undeclared role means the lane has no database of its own.",
          "type": "object",
          "properties": {
            "dev": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "engine": {
                      "type": "string",
                      "const": "sqlite"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Repo-relative path of the database file, e.g. `db.sqlite3`. Copied per lane."
                    },
                    "connection_url_var": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Env var the project reads its connection string from, set per lane."
                    }
                  },
                  "required": [
                    "engine",
                    "path",
                    "connection_url_var"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "engine": {
                      "type": "string",
                      "const": "postgres"
                    },
                    "delivery": {
                      "type": "string",
                      "enum": [
                        "external",
                        "compose"
                      ],
                      "description": "`external` forks a database on an already-running server — the cheap mode, and the one to prefer for pooling. `compose` boots the lane its own server on its own forked volume, which has no template to clone from and therefore no reset: such a lane is single-use and is re-provisioned rather than reset."
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The main checkout’s database name. Lane names derive from it."
                    },
                    "server_url": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The server, without the database path segment, e.g. `postgres://localhost:5432`."
                    },
                    "connection_url_var": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "engine",
                    "delivery",
                    "name",
                    "server_url",
                    "connection_url_var"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "One forked database a lane gets its own copy of."
            },
            "test": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "engine": {
                      "type": "string",
                      "const": "sqlite"
                    },
                    "path": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Repo-relative path of the database file, e.g. `db.sqlite3`. Copied per lane."
                    },
                    "connection_url_var": {
                      "type": "string",
                      "minLength": 1,
                      "description": "Env var the project reads its connection string from, set per lane."
                    }
                  },
                  "required": [
                    "engine",
                    "path",
                    "connection_url_var"
                  ],
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "properties": {
                    "engine": {
                      "type": "string",
                      "const": "postgres"
                    },
                    "delivery": {
                      "type": "string",
                      "enum": [
                        "external",
                        "compose"
                      ],
                      "description": "`external` forks a database on an already-running server — the cheap mode, and the one to prefer for pooling. `compose` boots the lane its own server on its own forked volume, which has no template to clone from and therefore no reset: such a lane is single-use and is re-provisioned rather than reset."
                    },
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The main checkout’s database name. Lane names derive from it."
                    },
                    "server_url": {
                      "type": "string",
                      "minLength": 1,
                      "description": "The server, without the database path segment, e.g. `postgres://localhost:5432`."
                    },
                    "connection_url_var": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "engine",
                    "delivery",
                    "name",
                    "server_url",
                    "connection_url_var"
                  ],
                  "additionalProperties": false
                }
              ],
              "description": "One forked database a lane gets its own copy of."
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "migrate_cmd"
      ],
      "additionalProperties": false,
      "description": "What a lane needs to be a working checkout of this project. Optional: with no project block a lane is a worktree and nothing else."
    },
    "defaults": {
      "type": "object",
      "properties": {
        "harness": {
          "type": "string",
          "enum": [
            "claude-code",
            "codex",
            "opencode"
          ]
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "pipeline": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "max_session_turns": {
          "default": 12,
          "description": "Turns one reused session slot may take before the next spawn starts fresh (§15.5). A shared session only ever grows; without a ceiling a long node eventually dies on a context-window error that reads as a broken harness.",
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "harness",
        "model",
        "pipeline"
      ],
      "additionalProperties": false
    },
    "crew": {
      "default": {},
      "description": "The agents this plan is staffed with, by id. Empty — the default — means the workflow is unstaffed and every node falls back to `model` / `defaults.model`, which is how workflows written before rosters existed keep running.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "role": {
            "default": "implementer",
            "description": "Implementers take phases; reviewers read them. No member does both, which is what makes self-review unrepresentable rather than merely unlikely.",
            "type": "string",
            "enum": [
              "implementer",
              "reviewer"
            ]
          },
          "tier": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Difficulty tier this member is staffed at, per the plan skill’s rubric. It is a floor on what they may be handed, and the ordering the scheduler substitutes along."
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "description": "The model this tier resolves to for this run."
          },
          "harness": {
            "description": "Overrides defaults.harness for this member.",
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "opencode"
            ]
          },
          "description": {
            "description": "Why the plan staffed this tier.",
            "type": "string"
          }
        },
        "required": [
          "tier",
          "model"
        ],
        "additionalProperties": false
      }
    },
    "resources": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "capacity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991,
            "description": "Maximum concurrent holders. A starting hint for `lane` — see admission control."
          },
          "kind": {
            "type": "string",
            "enum": [
              "worktree",
              "semaphore"
            ],
            "description": "`worktree` pools are provisioned lanes; `semaphore` pools are pure counters."
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "capacity",
          "kind"
        ],
        "additionalProperties": false
      },
      "description": "Named capacity pools. `lane` is required."
    },
    "gates": {
      "default": {},
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "cmd": {
            "type": "string",
            "minLength": 1,
            "description": "Shell command run in the node’s lane. Not an agent."
          },
          "requires": {
            "default": [],
            "description": "Resource pool ids acquired before the gate runs, in canonical order.",
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "timeout_s": {
            "default": 1800,
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "cmd"
        ],
        "additionalProperties": false
      }
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "depends_on": {
            "default": [],
            "description": "Empty means the node branches from base_branch and may start immediately.",
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "node": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "description": "The upstream node id."
                },
                "artifact": {
                  "type": "string",
                  "minLength": 1,
                  "description": "What this node needs from the upstream one — a model, a symbol, a migration, an endpoint. Required: it is what the implementer prompt uses to explain what the phase builds on, and a bare id with no reason is usually a plan smell."
                }
              },
              "required": [
                "node",
                "artifact"
              ],
              "additionalProperties": false
            }
          },
          "prompt_ref": {
            "type": "string",
            "minLength": 1,
            "description": "Where the phase brief lives, e.g. `plan.md#phase-1`."
          },
          "touches": {
            "default": [],
            "description": "Touch List. Same-wave overlap is warned about, never refused.",
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "pipeline": {
            "description": "Overrides defaults.pipeline.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "gates": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "harness": {
            "description": "Overrides defaults.harness.",
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "opencode"
            ]
          },
          "model": {
            "description": "Overrides defaults.model. Mutually exclusive with `crew`, which carries a model.",
            "type": "string"
          },
          "crew": {
            "description": "The implementer this phase is assigned to. Their tier is the floor for it: a busier roster may hand the phase to a free implementer at that tier or above, never below. Its reviewer is not named here — it is the cheapest reviewer on the roster who is qualified for this phase, and it is never this member.",
            "type": "string",
            "minLength": 1,
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "max_fix_rounds": {
            "default": 2,
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "name",
          "prompt_ref"
        ],
        "additionalProperties": false
      }
    },
    "pipelines": {
      "default": {},
      "description": "Pipelines this workflow authors. Optional: `defaults.pipeline` may name one the package ships (see BUILT_IN_PIPELINES), and a declared id shadows a built-in of the same name. A pipeline is machinery, not plan data — requiring every emitted workflow to carry a verbatim copy would duplicate it into every plan, and a fix to the shipped one would never reach a plan already written.",
      "type": "object",
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "pattern": "^[a-z0-9][a-z0-9-]*$"
      },
      "additionalProperties": {
        "type": "object",
        "properties": {
          "states": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "name": {
                  "type": "string",
                  "minLength": 1
                },
                "position": {
                  "type": "object",
                  "properties": {
                    "x": {
                      "type": "number"
                    },
                    "y": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "x",
                    "y"
                  ],
                  "additionalProperties": false,
                  "description": "Canvas position."
                },
                "onEnter": {
                  "default": [],
                  "description": "Effects run on entering the state.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[a-z0-9][a-z0-9-]*$",
                        "description": "Unique within its containing state or transition."
                      },
                      "definitionId": {
                        "type": "string",
                        "enum": [
                          "spawn_agent",
                          "run_gate",
                          "git_branch",
                          "git_merge",
                          "git_push",
                          "open_pr",
                          "write_tracking",
                          "await_human",
                          "notify"
                        ],
                        "description": "Which catalog verb this effect invokes."
                      },
                      "name": {
                        "description": "Display label. Falls back to definitionId.",
                        "type": "string"
                      },
                      "params": {
                        "default": {},
                        "description": "Arguments for the verb.",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "enabled": {
                        "default": true,
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      },
                      "data": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {},
                        "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
                      }
                    },
                    "required": [
                      "id",
                      "definitionId"
                    ],
                    "additionalProperties": false
                  }
                },
                "onLeave": {
                  "default": [],
                  "description": "Effects run on leaving the state.",
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[a-z0-9][a-z0-9-]*$",
                        "description": "Unique within its containing state or transition."
                      },
                      "definitionId": {
                        "type": "string",
                        "enum": [
                          "spawn_agent",
                          "run_gate",
                          "git_branch",
                          "git_merge",
                          "git_push",
                          "open_pr",
                          "write_tracking",
                          "await_human",
                          "notify"
                        ],
                        "description": "Which catalog verb this effect invokes."
                      },
                      "name": {
                        "description": "Display label. Falls back to definitionId.",
                        "type": "string"
                      },
                      "params": {
                        "default": {},
                        "description": "Arguments for the verb.",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "enabled": {
                        "default": true,
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      },
                      "data": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {},
                        "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
                      }
                    },
                    "required": [
                      "id",
                      "definitionId"
                    ],
                    "additionalProperties": false
                  }
                },
                "color": {
                  "type": "string"
                },
                "description": {
                  "type": "string"
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
                }
              },
              "required": [
                "id",
                "name",
                "position"
              ],
              "additionalProperties": false
            }
          },
          "transitions": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-]*$"
                },
                "name": {
                  "type": "string"
                },
                "from": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "description": "Source state id."
                },
                "to": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[a-z0-9][a-z0-9-]*$",
                  "description": "Target state id."
                },
                "trigger": {
                  "description": "Event name that fires this transition.",
                  "type": "string"
                },
                "guard": {
                  "description": "Opaque boolean expression over the documented guard context (review.verdict, gate.exit_code, human.answer, fix_rounds, node.*, run.*). Evaluated by a restricted evaluator with no host access.",
                  "type": "string"
                },
                "effects": {
                  "default": [],
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": {
                        "type": "string",
                        "minLength": 1,
                        "pattern": "^[a-z0-9][a-z0-9-]*$",
                        "description": "Unique within its containing state or transition."
                      },
                      "definitionId": {
                        "type": "string",
                        "enum": [
                          "spawn_agent",
                          "run_gate",
                          "git_branch",
                          "git_merge",
                          "git_push",
                          "open_pr",
                          "write_tracking",
                          "await_human",
                          "notify"
                        ],
                        "description": "Which catalog verb this effect invokes."
                      },
                      "name": {
                        "description": "Display label. Falls back to definitionId.",
                        "type": "string"
                      },
                      "params": {
                        "default": {},
                        "description": "Arguments for the verb.",
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {}
                      },
                      "enabled": {
                        "default": true,
                        "type": "boolean"
                      },
                      "description": {
                        "type": "string"
                      },
                      "data": {
                        "type": "object",
                        "propertyNames": {
                          "type": "string"
                        },
                        "additionalProperties": {},
                        "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
                      }
                    },
                    "required": [
                      "id",
                      "definitionId"
                    ],
                    "additionalProperties": false
                  }
                },
                "data": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {},
                  "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
                }
              },
              "required": [
                "id",
                "from",
                "to"
              ],
              "additionalProperties": false
            }
          },
          "initialStateIds": {
            "minItems": 1,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "finalStateIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "pattern": "^[a-z0-9][a-z0-9-]*$"
            }
          },
          "data": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {},
            "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
          }
        },
        "required": [
          "states",
          "initialStateIds"
        ],
        "additionalProperties": false,
        "description": "A per-phase pipeline, authored in vinta-state-machine-editor."
      }
    },
    "data": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {},
      "description": "Host-owned passthrough. Preserved verbatim and never interpreted."
    }
  },
  "required": [
    "schema_version",
    "id",
    "base_branch",
    "defaults",
    "resources",
    "nodes"
  ],
  "additionalProperties": false
}
