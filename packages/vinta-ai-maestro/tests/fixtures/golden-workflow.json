{
  "$schema": "https://github.com/vintasoftware/vinta-ai-workflows/schemas/workflow.v1.schema.json",
  "schema_version": 1,
  "id": "bookmark-folders",
  "plan_ref": "ai-plans/PLAN_bookmark-folders.md",
  "base_branch": "main",
  "defaults": {
    "harness": "claude-code",
    "model": "opus",
    "pipeline": "standard-phase"
  },
  "resources": {
    "lane": {
      "capacity": 3,
      "kind": "worktree"
    },
    "test-suite": {
      "capacity": 1,
      "kind": "semaphore"
    }
  },
  "gates": {
    "types": {
      "cmd": "pnpm typecheck",
      "timeout_s": 300
    },
    "unit": {
      "cmd": "pnpm test",
      "requires": [
        "test-suite"
      ],
      "timeout_s": 1800
    }
  },
  "nodes": [
    {
      "id": "p1",
      "name": "BookmarkFolder model + migration",
      "prompt_ref": "ai-plans/PLAN_bookmark-folders.md#phase-1",
      "touches": [
        "apps/bookmarks/models.py",
        "apps/bookmarks/migrations/"
      ],
      "gates": [
        "types",
        "unit"
      ]
    },
    {
      "id": "p2",
      "name": "Folder CRUD API",
      "depends_on": [
        {
          "node": "p1",
          "artifact": "the BookmarkFolder model"
        }
      ],
      "prompt_ref": "ai-plans/PLAN_bookmark-folders.md#phase-2",
      "touches": [
        "apps/bookmarks/api.py"
      ],
      "gates": [
        "types",
        "unit"
      ]
    },
    {
      "id": "p3",
      "name": "Folder tree serializer",
      "depends_on": [
        {
          "node": "p1",
          "artifact": "the BookmarkFolder model"
        }
      ],
      "prompt_ref": "ai-plans/PLAN_bookmark-folders.md#phase-3",
      "touches": [
        "apps/bookmarks/serializers.py"
      ],
      "gates": [
        "types",
        "unit"
      ]
    },
    {
      "id": "p4",
      "name": "Folder sidebar UI",
      "depends_on": [
        {
          "node": "p2",
          "artifact": "the /api/folders endpoints"
        },
        {
          "node": "p3",
          "artifact": "the nested tree payload shape"
        }
      ],
      "prompt_ref": "ai-plans/PLAN_bookmark-folders.md#phase-4",
      "touches": [
        "frontend/src/Sidebar.tsx"
      ],
      "gates": [
        "types"
      ],
      "harness": "codex",
      "max_fix_rounds": 3
    }
  ],
  "pipelines": {
    "standard-phase": {
      "states": [
        {
          "id": "implement",
          "name": "Implement",
          "position": {
            "x": 0,
            "y": 0
          }
        },
        {
          "id": "review",
          "name": "Review",
          "position": {
            "x": 200,
            "y": 0
          }
        },
        {
          "id": "fix",
          "name": "Fix",
          "position": {
            "x": 200,
            "y": 120
          }
        },
        {
          "id": "gate",
          "name": "Gate",
          "position": {
            "x": 400,
            "y": 0
          }
        },
        {
          "id": "integrate",
          "name": "Integrate",
          "position": {
            "x": 600,
            "y": 0
          },
          "onEnter": [
            {
              "id": "merge",
              "definitionId": "git_merge",
              "params": {
                "strategy": "--no-ff"
              }
            }
          ]
        },
        {
          "id": "done",
          "name": "Done",
          "position": {
            "x": 800,
            "y": 0
          }
        },
        {
          "id": "failed",
          "name": "Failed",
          "position": {
            "x": 400,
            "y": 240
          }
        }
      ],
      "transitions": [
        {
          "id": "t-implemented",
          "from": "implement",
          "to": "review",
          "effects": [
            {
              "id": "e-review",
              "definitionId": "spawn_agent",
              "params": {
                "role": "reviewer"
              }
            }
          ]
        },
        {
          "id": "t-review-pass",
          "from": "review",
          "to": "gate",
          "guard": "review.verdict == 'pass'"
        },
        {
          "id": "t-review-fail",
          "from": "review",
          "to": "fix",
          "guard": "review.verdict == 'fail'"
        },
        {
          "id": "t-gate-pass",
          "from": "gate",
          "to": "integrate",
          "guard": "gate.exit_code == 0"
        },
        {
          "id": "t-gate-fail",
          "from": "gate",
          "to": "fix",
          "guard": "gate.exit_code != 0"
        },
        {
          "id": "t-fix-retry",
          "from": "fix",
          "to": "review",
          "guard": "fix_rounds < node.max_fix_rounds"
        },
        {
          "id": "t-fix-exhausted",
          "from": "fix",
          "to": "failed",
          "guard": "fix_rounds >= node.max_fix_rounds"
        },
        {
          "id": "t-integrated",
          "from": "integrate",
          "to": "done"
        }
      ],
      "initialStateIds": [
        "implement"
      ],
      "finalStateIds": [
        "done",
        "failed"
      ]
    }
  }
}
