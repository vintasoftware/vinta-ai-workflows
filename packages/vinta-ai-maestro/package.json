{
  "name": "vinta-ai-maestro",
  "version": "0.7.0-alpha20",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vintasoftware/vinta-ai-workflows.git",
    "directory": "packages/vinta-ai-maestro"
  },
  "description": "Code-orchestrated parallel execution of plan-feature plans across agent harnesses.",
  "type": "module",
  "bin": {
    "vinta-ai-maestro": "./dist/cli/bin.js"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "node scripts/build.mjs",
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "schema:gen": "node --experimental-strip-types src/schema/generate.ts",
    "schema:check": "node --experimental-strip-types src/schema/generate.ts --check",
    "postmortem:schema:gen": "node --experimental-strip-types src/postmortem/generate.ts",
    "postmortem:schema:check": "node --experimental-strip-types src/postmortem/generate.ts --check",
    "intervention:schema:gen": "node --experimental-strip-types src/intervention/generate.ts",
    "intervention:schema:check": "node --experimental-strip-types src/intervention/generate.ts --check",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "hono": "^4.13.7",
    "node-pty": "^1.1.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "jsdom": "^30.0.1",
    "lucide-react": "^1.44.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vinta-dag-editor": "workspace:*",
    "vinta-design-system": "workspace:*",
    "vinta-state-machine-editor": "^0.11.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "files": [
    "dist",
    "scripts",
    "README.md"
  ]
}
