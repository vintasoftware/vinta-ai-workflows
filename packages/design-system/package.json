{
  "name": "vinta-design-system",
  "version": "0.0.0",
  "private": true,
  "description": "Vinta's design system for browser UIs in this workspace: oklch tokens, shadcn/ui components, and a small layout kit on Tailwind CSS v4.",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./ui/*": "./src/ui/*.tsx",
    "./layout": "./src/layout/index.ts",
    "./layout/*": "./src/layout/*.tsx",
    "./lib/utils": "./src/lib/utils.ts",
    "./lib/theme": "./src/lib/theme.ts",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/fonts.css": "./src/styles/fonts.css",
    "./styles/globals.css": "./src/styles/globals.css"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "biome check src tests",
    "format": "biome format --write src tests"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.44.0",
    "radix-ui": "^1.6.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.12",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "license": "MIT"
}
