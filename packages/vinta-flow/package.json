{
  "name": "vinta-flow",
  "version": "0.0.0",
  "private": true,
  "description": "Code-orchestrated parallel execution of plan-feature plans across agent harnesses.",
  "type": "module",
  "bin": {
    "vinta-flow": "./src/cli/bin.ts"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p ui/tsconfig.json",
    "test": "vitest run",
    "ui:dev": "vite --config ui/vite.config.ts",
    "ui:build": "vite build --config ui/vite.config.ts",
    "schema:gen": "node --experimental-strip-types src/schema/generate.ts",
    "schema:check": "node --experimental-strip-types src/schema/generate.ts --check",
    "postmortem:schema:gen": "node --experimental-strip-types src/postmortem/generate.ts",
    "postmortem:schema:check": "node --experimental-strip-types src/postmortem/generate.ts --check",
    "postinstall": "node scripts/fix-node-pty.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "better-sqlite3": "^13.0.3",
    "hono": "^4.13.7",
    "node-pty": "^1.1.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vinta-dag-editor": "workspace:*",
    "vinta-state-machine-editor": "^0.11.0",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  }
}
